# Overrides applied on top of .env when NODE_ENV=test (see bin/test.ts).
# Points the test run at an isolated database so tests never touch dev data.
DB_DATABASE=auth_system_test

# Consulta de NIF (serviço externo bknkv-utils-api-resources).
# NÃO pode ser 3333 — é a porta deste backend.
NIF_API_URL=http://127.0.0.1:3400
NIF_API_TIMEOUT_MS=20000
NIF_CACHE_DIAS=30
