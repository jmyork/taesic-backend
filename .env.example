# ─────────────────────────────────────────────────────────────────────────────
# taesic-backend — variáveis de ambiente
#
# Copie para `.env` e preencha. O `.env` não é versionado: cada ambiente tem o
# seu. Tudo o que está aqui é validado no arranque por `start/env.ts` — uma
# obrigatória em falta impede o arranque, de propósito.
# ─────────────────────────────────────────────────────────────────────────────

# Fuso horário. Lido pelo Node directamente, não pelo código da aplicação, e
# por isso exige um nome IANA — `Africa/Luanda`, não a abreviatura `WAT`, que o
# Node ignora em silêncio caindo no fuso do sistema operativo.
TZ=Africa/Luanda

NODE_ENV=development
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=generate-with-node-ace-generate-key

# ── Sessão ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=cookie

# Domínio do cookie de sessão. Ausente (ou vazio) em desenvolvimento: o cookie
# fica preso a localhost, que é o correcto. Em produção, onde o frontend está em
# app.taesic.bknkv.com e a API em api.taesic.bknkv.com, o ponto inicial é que
# faz o cookie cobrir os dois subdomínios:
#   SESSION_COOKIE_DOMAIN=.taesic.bknkv.com
SESSION_COOKIE_DOMAIN=

# ── URLs do frontend ─────────────────────────────────────────────────────────
# OBRIGATÓRIA. Os emails de activação e de reposição de password apontam para
# PÁGINAS do frontend, nunca para a API. Sem isto, um servidor de produção
# enviaria aos utilizadores links para a máquina deles próprios.
FRONTEND_URL=http://localhost:3000

# Página que recebe o token de definição de password, se não for a derivada de
# FRONTEND_URL. Opcional — ausente, usa-se <FRONTEND_URL>/reset-password/:token.
# O marcador `:token` é substituído pelo token real.
#APP_PASSWORD_DEFINITION_URL=

# ── Base de dados ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=alaragest

# ── Email (Resend — substituiu o SMTP/Mailpit) ───────────────────────────────
RESEND_API_KEY=replace-with-your-own-resend-api-key

# Endpoint alternativo da Resend. Opcional; só para testes contra um duplo.
#RESEND_BASE_URL=

# Remetente. O domínio tem de estar verificado na Resend, senão os envios são
# recusados. Opcional — ausente, usa-se noreply@taesic.com.
MAIL_FROM=BKNKV

# ── Alertas operacionais ─────────────────────────────────────────────────────
# Estoque crítico, produto perto da validade, venda cancelada de alto valor,
# reversão de estoque — ver app/listeners/estoque_alertas.ts. Sem ALERT_EMAIL os
# alertas continuam a ser calculados, mas nenhum email é enviado.
ALERT_EMAIL=
ESTOQUE_LIMIAR_CRITICO=5
LOTE_VALIDADE_ALERTA_DIAS=30
VENDA_CANCELADA_LIMIAR=50000

# ── Armazenamento de ficheiros (Cloudflare R2) ───────────────────────────────
DRIVE_DISK=r2
R2_KEY=replace-with-your-own-r2-access-key-id
R2_SECRET=replace-with-your-own-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Base pública para servir as imagens do bucket. OPCIONAL.
#
# ATENÇÃO: o R2_ENDPOINT acima é o endpoint S3 e NÃO é legível publicamente — um
# <img src> para lá recebe 401. Sem esta variável os URLs guardados na base de
# dados apontam para lá, e as imagens não aparecem.
#
#   desenvolvimento : https://<subdominio>.r2.dev   (URL de dev do R2)
#   produção        : https://cdn.taesic.bknkv.com  (domínio próprio do bucket)
#
# Usar a raiz do domínio, sem segmento de caminho: a eliminação de imagens
# deriva o caminho do objecto a partir deste URL (ver app/helpers/r2_url.ts).
R2_PUBLIC_URL=

# ── CORS ────────────────────────────────────────────────────────────────────
# Origens de browser autorizadas, separadas por vírgula. Com o BFF do frontend,
# os pedidos passaram a ser servidor-a-servidor e não passam por CORS, por isso
# isto normalmente pode ficar vazio. Ausente: tudo em desenvolvimento, nada em
# produção.
#   CORS_ORIGINS=https://app.taesic.bknkv.com
CORS_ORIGINS=

# Segredo partilhado com o servidor do frontend. Definido, esta API recusa
# (403) qualquer pedido que nao o traga no cabecalho x-bff-secret.
#
# O CORS acima NAO faz isto: e uma regra que o browser aplica, e um curl
# ignora-a. Isto vale contra qualquer cliente.
#
# Ausente, nao faz nada. Activar exige o MESMO valor no .env do frontend.
# Gerar com:  openssl rand -base64 48
#
# E a segunda tranca, nao a primeira: a fronteira a serio e a rede — esta API
# nao devia ser alcancavel a partir da Internet, so a partir do host do frontend.
BFF_SHARED_SECRET=

# O mesmo, para o SEGUNDO frontend: o backoffice da plataforma (taesic-backoffice).
# Valor DIFERENTE do de cima — sao dois clientes distintos e cada um roda-se sem
# tocar no outro. Duas variaveis em vez de uma lista por virgulas porque um segredo
# e texto arbitrario e uma virgula la dentro partiria a lista em silencio.
BFF_SHARED_SECRET_BACKOFFICE=

# ── Rotas de plataforma (backoffice) ─────────────────────────────────────────
# O grupo adminOnly governa a plataforma inteira, cross-tenant: suspender empresas,
# planos, taxas de IVA, relatorios de TODOS os inquilinos.
#
# false = essas rotas nem chegam a ser registadas (404, como um caminho inventado).
# Serve para o mesmo build ir para duas instancias: a publica, exposta a Internet,
# com isto a false; a restrita, atras de VPN ou lista de IPs, com isto ligado.
#
# Ausente = ligado, para nenhum deploy actual mudar de comportamento ao actualizar.
# Nao substitui o portao: registadas ou nao, estas rotas continuam a exigir
# autenticacao e um papel de escopo `plataforma`.
PLATFORM_ROUTES_ENABLED=

# ── Documentacao da API (/swagger e /docs) ───────────────────────────────────
# Publicar a especificacao entrega o mapa completo do que atacar: 146 caminhos,
# com parametros e formatos, sem ser preciso adivinhar um unico nome.
#
# Omitida: ligada fora de producao, DESLIGADA em producao (as rotas nem sao
# registadas). Poe-la a true em producao e uma decisao explicita.
#
# Nota: nao bastava fechar aqui. O BFF do frontend devolvia /swagger a qualquer
# visitante anonimo, porque era ELE a acrescentar o BFF_SHARED_SECRET. Esse lado
# ja esta fechado (o BFF so encaminha /api/).
API_DOCS_ENABLED=
# ── Rate limiting ────────────────────────────────────────────────────────────
LIMITER_STORE=database

# ── Consulta de NIF (serviço externo bknkv-utils-api-resources) ──────────────
# NÃO pode ser 3333 — é a porta deste backend.
NIF_API_URL=http://127.0.0.1:3400
NIF_API_TIMEOUT_MS=20000
NIF_CACHE_DIAS=30
