TZ=WAT
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=generate-with-node-ace-generate-key
NODE_ENV=development
SESSION_DRIVER=cookie
# Domínio do cookie de sessão. Ausente (ou vazio) em desenvolvimento: o cookie
# fica preso a localhost, que é o correcto. Em produção, onde o frontend está em
# app.taesic.bknkv.com e a API em api.taesic.bknkv.com, o ponto inicial é que
# faz o cookie cobrir os dois subdomínios:
#   SESSION_COOKIE_DOMAIN=.taesic.bknkv.com
SESSION_COOKIE_DOMAIN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=alaragest
# Envio de email: Resend (substituiu o SMTP/Mailpit).
RESEND_API_KEY=re_coloque_a_sua_chave
MAIL_FROM=BKNKV
RESEND_API_KEY=replace-with-your-own-resend-api-key

# Alertas operacionais (estoque crítico, produto perto da validade, venda cancelada de
# alto valor, reversão de estoque) — ver app/listeners/estoque_alertas.ts. Sem
# ALERT_EMAIL configurado, os alertas são calculados mas nenhum email é enviado.
ALERT_EMAIL=
ESTOQUE_LIMIAR_CRITICO=5
LOTE_VALIDADE_ALERTA_DIAS=30
VENDA_CANCELADA_LIMIAR=50000

# Drive
DRIVE_DISK=r2
R2_KEY=replace-with-your-own-r2-access-key-id
R2_SECRET=replace-with-your-own-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Base pública para servir as imagens do bucket. OPCIONAL.
#
# ATENÇÃO: o R2_ENDPOINT acima é o endpoint S3 e NÃO é legível publicamente — um
# <img src> para lá recebe 401. Sem esta variável os URLs guardados na base de
# dados apontam para lá, e as imagens não aparecem.
#
#   desenvolvimento : https://<subdominio>.r2.dev   (URL de dev do R2)
#   produção        : https://cdn.taesic.bknkv.com  (domínio próprio do bucket)
#
# Usar a raiz do domínio, sem segmento de caminho: a eliminação de imagens
# deriva o caminho do objecto a partir deste URL (ver app/helpers/r2_url.ts).
R2_PUBLIC_URL=
LIMITER_STORE=database
# Consulta de NIF (serviço externo bknkv-utils-api-resources).
# NÃO pode ser 3333 — é a porta deste backend.
NIF_API_URL=http://127.0.0.1:3400
NIF_API_TIMEOUT_MS=20000
NIF_CACHE_DIAS=30
