{{-- Alerta operacional (estoque crítico, validade próxima, venda cancelada de alto valor,
     reversão de estoque) — uma view para todos, com as linhas geradas pelo listener. --}}
@component('emails/components/carta', {
  year,
  preheader: titulo + ' — alerta automático da sua conta TAESIC.'
})

  @component('emails/components/titulo')
    {{ titulo }}
  @end

  @component('emails/components/aviso')
    @each(linha in linhas)
      {{ linha }}<br />
    @end
  @end

  @component('emails/components/nota')
    Alerta gerado automaticamente a partir da actividade registada na plataforma.
    Confirme a situação no TAESIC antes de tomar qualquer decisão.
  @end

@end
