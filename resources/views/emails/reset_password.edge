{{-- Pedido de recuperação de palavra-passe (auth_repository.forgot_password). --}}
@component('emails/components/carta', {
  year,
  preheader: 'Escolha uma nova palavra-passe. O link é válido durante 24 horas.'
})

  @component('emails/components/titulo')
    Redefinir a palavra-passe
  @end

  @component('emails/components/texto')
    Olá, {{ user.username }}. Recebemos um pedido para redefinir a palavra-passe da conta
    associada a <span class="strong" style="font-weight:600;color:#0f172a;">{{ user.email }}</span>.
    É você que escolhe a nova, no formulário — nunca a geramos nem a enviamos por email.
  @end

  @!component('emails/components/botao', {
    url: resetUrl,
    texto: 'Escolher nova palavra-passe',
    nota: 'Válido 24 horas, uma única vez.'
  })

  @component('emails/components/nota')
    Se não foi você a pedir esta redefinição, ignore este email: a palavra-passe actual
    continua válida e nada muda na sua conta.
  @end

@end
