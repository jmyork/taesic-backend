            @include('emails/partials/taesic_header')

            <tr>
              <td class="px" style="padding:34px 40px 30px 40px;">

                <p class="eyebrow" style="margin:0 0 10px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:11px;line-height:16px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#1e3a8a;">
                  Painel de promotor
