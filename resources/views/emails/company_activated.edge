{{-- Empresa activada (listener de EmpresaActivated). O botão só aparece se houver link de
     definição de palavra-passe — antes o listener nunca o passava e ficava sem destino. --}}
@component('emails/components/carta', {
  year,
  preheader: 'A conta está activa. Já pode entrar na plataforma.'
})

  @component('emails/components/titulo')
    Bem-vindo ao TAESIC, {{ userName }}
  @end

  @component('emails/components/texto')
    A empresa <span class="strong" style="font-weight:600;color:#0f172a;">{{ companyName }}</span>
    está activada. Já pode entrar com o seu email e a palavra-passe que escolheu no registo.
  @end

  @component('emails/components/painel')
    <p class="panel-label" style="margin:0 0 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:11px;line-height:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#94a3b8;">Por onde começar</p>
    <p class="text" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:14.5px;line-height:24px;color:#334155;">
      1. Complete os dados da empresa e as contas bancárias.<br />
      2. Registe os produtos e o stock inicial.<br />
      3. Crie as contas da equipa — cada pessoa recebe um email para definir a sua palavra-passe.
    </p>
  @end

  @if(password_definition_url)
    @!component('emails/components/botao', {
      url: password_definition_url,
      texto: 'Definir nova palavra-passe',
      nota: 'Só se quiser trocar de palavra-passe antes de entrar. Válido 24 horas.'
    })
  @end

@end
