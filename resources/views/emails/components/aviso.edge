{{-- Caixa âmbar de aviso. O slot é texto simples (o parágrafo é este componente que o
     faz) — para conteúdo em blocos, usar `painel`. --}}
<table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="margin:0 0 18px 0;">
  <tr>
    <td class="notice" bgcolor="#fffbeb" style="background-color:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:13px 16px;">
      <p class="notice-text" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:13.5px;line-height:21px;color:#92400e;">{{{ await $slots.main() }}}</p>
    </td>
  </tr>
</table>
